{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build Statistical Data Processing",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/StatisticalDataProcessing/VazquezStatisticalDataProcessing.cpp",
                "${workspaceFolder}/StatisticalDataProcessing/Dynamic_Array.cpp",
                "-o",
                "${workspaceFolder}/StatisticalDataProcessing/VazquezStatisticalDataProcessing"
            ],
            "options": {
                "cwd": "${workspaceFolder}/StatisticalDataProcessing"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the Statistical Data Processing executable."
        }
    ]
}